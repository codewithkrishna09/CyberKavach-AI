CYBERKAVACH_DB_FILE=./cyberkavach_master.db
CYBERKAVACH_ALLOWED_ORIGINS=http://127.0.0.1:5501,http://localhost:5501
# Local development only. This permits loopback web servers and locally loaded
# Chrome extensions. Keep blank in production and list exact HTTPS origins above.
CYBERKAVACH_ALLOWED_ORIGIN_REGEX=^(?:http://(localhost|127\.0\.0\.1|0\.0\.0\.0|\[::1\]):[0-9]{1,5}|chrome-extension://[a-p]{32})$
# Add the exact installed extension origin, for example chrome-extension://<extension-id>
CYBERKAVACH_EXTENSION_ORIGINS=
CYBERKAVACH_ALLOWED_HOSTS=api.cyberkavach.ai,localhost,127.0.0.1
CYBERKAVACH_RATE_LIMIT_PER_MINUTE=120
CYBERKAVACH_MAX_APK_BYTES=52428800
CYBERKAVACH_MAX_FORENSIC_BYTES=20971520
CYBERKAVACH_URL_MODEL_PATH=
# Keep false until the model has been trained on a large, reviewed dataset and
# evaluated on unseen domains. This prevents a preliminary model from alerting users.
CYBERKAVACH_ENABLE_URL_MODEL=false
CYBERKAVACH_GOOGLE_SAFE_BROWSING_API_KEY=
CYBERKAVACH_THREAT_INTEL_TIMEOUT_SECONDS=3
CYBERKAVACH_THREAT_INTEL_CACHE_SECONDS=3600
CYBERKAVACH_SCAN_RESULT_CACHE_SECONDS=1800
